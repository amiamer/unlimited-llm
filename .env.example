# =============================================================================
# AI models — OpenRouter (one key for every model)
# =============================================================================
# Get a key at https://openrouter.ai/keys and buy credits there.
OPENROUTER_API_KEY=your_openrouter_api_key
# Chat default (the "GLM" choice in the model picker). Keep at z-ai/glm-5.2 or newer.
# OPENROUTER_MODEL=z-ai/glm-5.2
# The other picker choices, each overridable (defaults shown):
# OPENROUTER_CLAUDE_MODEL=anthropic/claude-opus-4.6
# OPENROUTER_GEMINI_MODEL=google/gemini-3-flash-preview
# OPENROUTER_GEMINI_PRO_MODEL=google/gemini-3.1-pro-preview
# OPENROUTER_KIMI_MODEL=moonshotai/kimi-k2.6
# Output-token cap per turn (raise for very large tool-call arguments)
# OPENROUTER_MAX_TOKENS=16384

# Kiro CLI (headless mode, desktop only)
# Get your API key from: https://app.kiro.dev/ → Settings → API Keys
KIRO_API_KEY=your-kiro-api-key-here
# Optional: timeout in ms for kiro-cli subprocess (default: 300000 = 5 minutes)
# KIRO_TIMEOUT_MS=300000
# Optional: working directory for kiro-cli subprocess (default: project root)
# KIRO_CWD=
# Optional: explicit path to kiro-cli binary (default: auto-detected from PATH or known install location)
# KIRO_CLI_PATH=C:\Users\YourName\AppData\Local\Kiro-Cli\kiro-cli.exe

# Tavily Web Search (for LLM real-time internet access)
# Get your free API key at: https://app.tavily.com (1,000 free credits/month)
TAVILY_API_KEY=your_tavily_api_key

# Application Security
# Set a strong password to protect your application (DEPRECATED - use Clerk instead)
APP_PASSWORD=your_secure_password_here

# Clerk Authentication
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Clerk Configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Email Allowlist (comma-separated list of allowed emails)
ALLOWED_EMAILS=you@example.com

# Google Calendar Integration
# Path to your Google Cloud service account JSON key file
# To create: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Google Calendar API and download the JSON key
GCAL_SERVICE_ACCOUNT_KEY_PATH=C:\path\to\your-service-account-key.json

# Google Calendar ID for tool calls (default: 'primary' uses the account's main calendar)
DEFAULT_CALENDAR_ID=primary

# Gmail Send Integration (OAuth2)
# Path to your OAuth2 client secret JSON file (downloaded from Cloud Console → Credentials)
GMAIL_CLIENT_SECRET_PATH=C:\path\to\client_secret_xxxxx.apps.googleusercontent.com.json
# Refresh token for Gmail send access (get by running: npx tsx scripts/gmail-auth.ts)
# Alternatively, leave this empty and the service will read from gmail-token.json
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# =============================================================================
# Reader Configuration (Required for EPUB reader)
# =============================================================================
# Path to directory where uploaded EPUB files are stored
BOOKS_PATH=C:\EPUBs

# =============================================================================
# Local Storage Configuration (Required)
# =============================================================================
# The application uses local file system storage for chat history and Obsidian
# integration. Both paths are required for the application to function.

# Chat Vault Path - Directory where chat conversations and sessions are stored
# This directory will be created automatically if it doesn't exist
# Example: C:\Users\YourName\Documents\Chats or /home/yourname/chats
CHAT_VAULT_PATH=C:\Chats

# Obsidian Vault Path - Path to your existing Obsidian vault directory
# This directory must already exist (the application will not create it)
# Notes created by the app will be stored in a "Notes" subfolder
# Example: C:\Users\YourName\Documents\ObsidianVault or /home/yourname/obsidian
OBSIDIAN_VAULT_PATH=C:\ObsidianVault

# Habit tracker data file (default: <OBSIDIAN_VAULT_PATH>/excluded/habit-tracker.json)
# HABIT_TRACKER_FILE=
# Reading-group schedules (default: <OBSIDIAN_VAULT_PATH>/excluded/reading-schedules.json)
# READING_SCHEDULES_FILE=

# Curated agent context is opt-in. Keep false until the files have been reviewed.
AGENT_CONTEXT_ENABLED=false
# Agent context directory, relative to OBSIDIAN_VAULT_PATH (default: _agent)
# AGENT_CONTEXT_DIR=_agent

# =============================================================================
# Legacy Storage (AWS S3) - Optional, for migration purposes only
# =============================================================================
# These settings are no longer used for primary storage operations.
# Keep them configured only if you need to migrate existing data from S3.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_bucket_name

# =============================================================================
# Legacy Obsidian Integration - No longer used
# =============================================================================
# The application now writes directly to the local Obsidian vault.
# These webhook settings are deprecated and will be removed in a future version.
# OBSIDIAN_WEBHOOK_URL=http://your-webhook-url
# OBSIDIAN_WEBHOOK_TIMEOUT=30000

# =============================================================================
# Development Server Port
# =============================================================================
# Port for the Next.js dev server. Used by ngrok and the Discord bot.
NEXT_DEV_PORT=3000

# =============================================================================
# Discord Bot Configuration
# =============================================================================
# Discord bot credentials from https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_APPLICATION_ID=your_discord_application_id
DISCORD_PUBLIC_KEY=your_discord_public_key
DISCORD_BOT_TOKEN=your_discord_bot_token

# API key for authenticating Discord bot requests to the chat API
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DISCORD_BOT_API_KEY=your_discord_bot_api_key

# Chat API URL for the Discord bot (auto-detects from NEXT_DEV_PORT if not set)
# Only set this if you need to override (e.g., pointing to ngrok URL)
# DISCORD_CHAT_API_URL=http://localhost:3000

# Default Discord channel for proactive daemon messages (nudges, reminders, alerts)
# Right-click a channel in Discord → Copy Channel ID (requires Developer Mode in settings)
DISCORD_DEFAULT_CHANNEL_ID=your_default_channel_id

# Default Discord user ID for web-to-Discord scheduling
# Right-click your username in Discord → Copy User ID (requires Developer Mode in settings)
DISCORD_DEFAULT_USER_ID=your_discord_user_id

# =============================================================================
# PDF Reader (Surya OCR Service, desktop only)
# =============================================================================
# URL of the Surya OCR Python service for PDF text extraction
# Start manually: conda activate surya && python scripts/pdf-server.py
PDF_SERVER_URL=http://localhost:8100

# =============================================================================
# Local dev / machine-specific overrides (all optional — sensible defaults exist)
# =============================================================================
# Loopback host for the PDF OCR sidecar. Defaults to 127.0.0.1 (LAN-safe).
# PDF_SERVER_HOST=127.0.0.1
# Path to the ngrok executable
# NGROK_PATH=C:\ngrok-v3-stable-windows-amd64\ngrok.exe

# =============================================================================
# Local terminal panel (chat -> terminal tab)
# =============================================================================
# Off unless true. Works only when the app is used on this computer (localhost);
# requests that come through a tunnel or proxy are refused.
ENABLE_LOCAL_TERMINAL=false
# Shell: bash (Git Bash on Windows, the default), wsl (Ubuntu), or powershell
# TERMINAL_SHELL=bash
# Folder new sessions start in (default: your home folder)
# TERMINAL_CWD=
# Port of the local terminal bridge (bound to 127.0.0.1)
# TERMINAL_PORT=3010
# Git Bash location, if not the default C:\Program Files\Git\bin\bash.exe
# TERMINAL_BASH_PATH=
